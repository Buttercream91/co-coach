# Copy this to `.env` (which is gitignored) and fill in real values.

# Neon Postgres — get this from https://console.neon.tech after creating a project.
# Pick the "Pooled connection" string. Example shape:
#   postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/co_coach?sslmode=require
DATABASE_URL=

# Long random string. Used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API server listens on. The Vite dev server proxies /api → here.
PORT=3001
